# Copy this file to .env (in this same folder) and edit it in VS Code, which saves UTF-8.
# .env is git-ignored: never commit it. A real environment variable wins over a line in .env.
# Write values without quotes. Use forward slashes in Windows paths (D:/Backups/...):
# inside double quotes, "\r" and "\n" in a path would turn into hidden control characters.

# The Claude API key, for imports read by Claude (docs/setup.md: "Connect the Claude API").
# Read at each import, so no restart is needed. Keep it only here: never in a chat or a commit.
# ANTHROPIC_API_KEY=sk-ant-...

# The Claude model for imports (default claude-opus-5-5; claude-sonnet-5-5 is cheaper), and how
# many seconds one request may take (default 120).
# RECIPES_MODEL=claude-opus-5-5
# RECIPES_MODEL_TIMEOUT_SECONDS=120

# Who reads imported text: claude (default) or ollama, a local model on this computer
# (docs/setup.md: "Run extraction on this computer"). With ollama, the text is not sent anywhere.
# RECIPES_EXTRACTOR=ollama
# RECIPES_OLLAMA_MODEL=qwen3:8b
# RECIPES_OLLAMA_CONTEXT_TOKENS=8192
# RECIPES_OLLAMA_TIMEOUT_SECONDS=300
# RECIPES_OLLAMA_URL=http://127.0.0.1:11434

# How the model turns the text into a recipe (docs/architecture.md: "How the model reads a recipe"):
# references (default): it labels numbered passages and the recipe's wording is copied from your
# text, so it cannot be misspelled. text: it retypes the recipe (the first approach, for comparison).
# RECIPES_EXTRACTION_MODE=references

# The settings below are read when the backend starts: restart it after a change.

# Where local data is kept: the recipes database (recipes.db) and Instagram probe runs; uploaded
# screenshots later. Must be a full path. Default: the data/ folder in this repository.
# RECIPES_DATA_DIR=D:/Backups/recipe-notebook

# true: print every SQL statement the backend runs, in its terminal. Default: false.
# RECIPES_SQL_ECHO=true
