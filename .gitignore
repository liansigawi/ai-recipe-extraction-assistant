# --- Local data (never commit) ---------------------------------------------
# Recipes database, uploaded screenshots, browser profiles, probe output.
/data/
# Safety net for a database created outside data/ by mistake.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Secrets ------------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# --- Node / frontend ------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
# Wrangler's local state, if it ever makes one (its login lives in your user profile, not here).
.wrangler/

# --- Playwright ------------------------------------------------------------------
playwright-report/
test-results/

# --- Editors / OS ----------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
